{
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go run:*)",
      "Bash(go list:*)",
      "Bash(go doc:*)",
      "Bash(go mod tidy)",
      "Bash(go mod download)",
      "Bash(gofmt:*)",
      "Bash(golangci-lint run:*)",
      "Bash(make check)",
      "Bash(make test)",
      "Bash(make race)",
      "Bash(make vet)",
      "Bash(make lint)",
      "Bash(make fuzz:*)",
      "Bash(make build)",
      "Bash(make demo)",
      "Bash(make interop)",
      "Bash(make bench:*)",
      "Bash(docker compose -f tests/interoperability/compose.yaml:*)",
      "Bash(docker compose -f tests/interoperability/bench-compose.yaml:*)",
      "Bash(./bin/qmuxd:*)",
      "Bash(./bin/qmuxctl:*)",
      "Bash(./bin/qmux-probe:*)",
      "Bash(python3 docs/specs/render-spec.py)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "command -v gofmt >/dev/null && command -v jq >/dev/null || exit 0; f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.go) gofmt -w \"$f\";; esac; exit 0"
          }
        ]
      }
    ]
  }
}
